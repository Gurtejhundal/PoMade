{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pomade",
  "version": "1.0.0",
  "description": "Keep README, real media, About, and topics in step with the code you push.",
  "author": {
    "name": "Gurtej Hundal",
    "url": "https://github.com/Gurtejhundal"
  },
  "homepage": "https://pomade-swart.vercel.app",
  "repository": "https://github.com/Gurtejhundal/Pomade",
  "license": "MIT",
  "keywords": [
    "readme",
    "github-actions",
    "developer-tools"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "PoMade",
        "shortDescription": "Code pushed. First impression handled.",
        "longDescription": "Inspect repository facts, choose one of three README styles, review changes, and maintain the presentation on pushes. Includes optional local hooks.",
        "developerName": "Gurtej Hundal",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://pomade-swart.vercel.app",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "defaultPrompt": [
          "Use PoMade to prepare this repository before pushing.",
          "Set up PoMade hooks and the push workflow."
        ]
      }
    }
  }
}
