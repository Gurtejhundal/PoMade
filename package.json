  "description": "Make every repo worth opening — Agent-native GitHub repository presentation and maintenance layer",
  "type": "module",
  "bin": {
    "pomade": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
