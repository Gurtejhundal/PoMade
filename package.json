{
  "name": "pomade",
  "version": "1.0.0-rc.1",
  "description": "Code pushed. First impression handled. README, media, About, and topics maintained alongside your code.",
  "type": "module",
  "bin": {
    "pomade": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "action.yml",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gurtejhundal/PoMade.git"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pomade": "tsx src/cli/bin.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:start": "npm --prefix site run start"
  },
  "keywords": [
    "agent-skills",
    "github",
    "readme",
    "documentation",
    "cli",
    "developer-tools",
    "ai-agents",
    "github-actions",
    "repository-presentation"
  ],
  "author": "Gurtej Hundal",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
